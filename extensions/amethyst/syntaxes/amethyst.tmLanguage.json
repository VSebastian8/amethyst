{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "myst",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#symbols"
		},
		{
			"include": "#entities"
		}
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.myst",
					"match": "(\\-\\-).*",
					"captures": {
						"1": {
							"name": "punctuation.definition.comment.myst"
						}
					}
				},
				{
					"name": "comment.block.myst",
					"begin": "(\\{\\-)",
					"beginCaptures": {
						"1": {
							"name": "punctuation.definition.comment.myst"
						}
					},
					"end": "(\\-\\})",
					"endCaptures": {
						"1": {
							"name": "punctuation.definition.comment.myst"
						}
					}
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.declaration.myst",
					"match": "\\b(automaton|state)\\b"
				},
				{
					"name": "keyword.control.myst",
					"match": "(?<!\\.)\\b(initial|accept|reject|as)\\b"
				},
				{
					"name": "keyword.operator.write.myst",
					"match": "(\\/)"
				},
				{
					"name": "keyword.operator.arrow.myst",
					"match": "(\\-\\>)"
				},
				{
					"name": "keyword.operator.move.myst",
					"match": "(\\,)"
				},
				{
					"name": "keyword.operator.assignment.myst",
					"match": "(\\=)"
				},
				{
					"name": "keyword.operator.dot.myst",
					"match": "(\\.)"
				}
			]
		},
		"symbols": {
			"patterns": [
				{
					"name": "support.constant.move.myst",
					"match": "(?<=\\,\\s*)(L|R|N)"
				},
				{
					"name": "constant.language.symbol.blank.myst",
					"match": "(@)"
				},
				{
					"name": "constant.language.symbol.wildcard.myst",
					"match": "(_)"
				},
				{
					"name": "constant.language.symbol.and.myst",
					"match": "(&)"
				},
				{
					"name": "constant.language.symbol.myst",
					"match": "([A-Z0-9])"
				},
				{
					"name": "punctuation.semi.myst",
					"match": "(;)"
				},
				{
					"name": "punctuation.brackets.curly.myst",
					"match": "(\\{|\\})"
				},
				{
					"name": "punctuation.brackets.round.myst",
					"match": "(\\(|\\))"
				}
			]
		},
		"entities": {
			"patterns": [
				{
					"name": "entity.name.function.automaton.myst",
					"match": "(?<=automaton\\s+)([a-z][a-z0-9_]*)"
				},
				{
					"name": "entity.name.type.component.myst",
					"match": "([a-z][a-z0-9_]*)(?=\\s+as)"
				},
				{
					"name": "entity.name.type.alias.myst",
					"match": "(?<=as\\s+)([a-z][a-z0-9_]*)"
				},
				{
					"name": "entity.name.type.alias.myst",
					"match": "([a-z][a-z0-9_]*)(?=\\.)"
				},
				{
					"name": "variable.other.state.myst",
					"match": "(?<=\\.)([a-z][a-z0-9_]*)"
				},
				{
					"name": "variable.other.state.myst",
					"match": "(?<=state\\s*)([a-z][a-z0-9_]*)"
				},
				{
					"name": "variable.other.state.myst",
					"match": "(?<=->\\s*)([a-z][a-z0-9_]*)"
				}
			]
		}
	},
	"scopeName": "source.myst"
}